<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F7FB">

    <!-- MODERN BLUE HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="#0D47A1"
        android:gravity="center_vertical"
        android:paddingTop="28dp"
        android:paddingHorizontal="16dp"
        android:elevation="4dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_back_arrow"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Back"
            android:padding="4dp"
            app:tint="#FFFFFF"/>
    </LinearLayout>

    <!-- MWILI WA UKURASA -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Available Rooms"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="#222222"/>

            <TextView
                android:id="@+id/tvSelectedBlockTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Selected Block"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#303F9F"
                android:layout_marginTop="4dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select a room that is available"
                android:textSize="15sp"
                android:textColor="#666666"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="20dp"/>

            <!-- ROOM CARD 1 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="15dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:cardUseCompatPadding="true">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp"
                    android:background="#FFFFFF">
                    <TextView
                        android:id="@+id/tvRoom1Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Room 101"
                        android:textSize="21sp"
                        android:textStyle="bold"
                        android:textColor="#222222"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Capacity: 4"
                        android:textSize="14sp"
                        android:textColor="#666666"
                        android:layout_marginTop="5dp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2 beds available"
                        android:textColor="#2E7D32"
                        android:textStyle="bold"
                        android:layout_marginTop="8dp"/>
                    <Button
                        android:id="@+id/btnRoom101"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:text="VIEW ROOM"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#303F9F"
                        android:layout_marginTop="12dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ROOM CARD 2 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="15dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:cardUseCompatPadding="true">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp"
                    android:background="#FFFFFF">
                    <TextView
                        android:id="@+id/tvRoom2Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Room 103"
                        android:textSize="21sp"
                        android:textStyle="bold"
                        android:textColor="#222222"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Capacity: 4"
                        android:textSize="14sp"
                        android:textColor="#666666"
                        android:layout_marginTop="5dp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3 beds available"
                        android:textColor="#2E7D32"
                        android:textStyle="bold"
                        android:layout_marginTop="8dp"/>
                    <Button
                        android:id="@+id/btnRoom103"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:text="VIEW ROOM"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#303F9F"
                        android:layout_marginTop="12dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ROOM CARD 3 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="15dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:cardUseCompatPadding="true">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp"
                    android:background="#FFFFFF">
                    <TextView
                        android:id="@+id/tvRoom3Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Room 205"
                        android:textSize="21sp"
                        android:textStyle="bold"
                        android:textColor="#222222"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Capacity: 6"
                        android:textSize="14sp"
                        android:textColor="#666666"
                        android:layout_marginTop="5dp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3 beds available"
                        android:textColor="#2E7D32"
                        android:textStyle="bold"
                        android:layout_marginTop="8dp"/>
                    <Button
                        android:id="@+id/btnRoom205"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:text="VIEW ROOM"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#303F9F"
                        android:layout_marginTop="12dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>
</LinearLayout>